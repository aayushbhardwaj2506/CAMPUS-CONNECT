# Copy to ".env" only if you want to override defaults. The app runs fine with none of these set.
PORT=3000
SESSION_SECRET=change-me-in-production
# CAMPUS_DB_PATH=./campus_connect.db

# --- DA3: Neo4j graph database (optional; the app runs without it) ---
# Put the real values in ".env.local" (git-ignored), never in this file.
# Local Neo4j Desktop:   bolt://localhost:7687      user: neo4j
# Neo4j Aura (cloud):    neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
