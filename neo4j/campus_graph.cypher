// Campus Connect: the DA3 graph (1324 nodes, 7482 relationships), exported from Neo4j.
// Load into an EMPTY Neo4j database:  npm run graph:load   (or paste into Neo4j Browser / cypher-shell -f).
// It uses a temporary helper label (_X) and property (_eid); both are removed in the last statements.

CREATE CONSTRAINT school_schoolId IF NOT EXISTS FOR (n:School) REQUIRE n.schoolId IS UNIQUE;
CREATE CONSTRAINT department_deptId IF NOT EXISTS FOR (n:Department) REQUIRE n.deptId IS UNIQUE;
CREATE CONSTRAINT program_programId IF NOT EXISTS FOR (n:Program) REQUIRE n.programId IS UNIQUE;
CREATE CONSTRAINT course_courseId IF NOT EXISTS FOR (n:Course) REQUIRE n.courseId IS UNIQUE;
CREATE CONSTRAINT person_userId IF NOT EXISTS FOR (n:Person) REQUIRE n.userId IS UNIQUE;
CREATE CONSTRAINT club_clubId IF NOT EXISTS FOR (n:Club) REQUIRE n.clubId IS UNIQUE;
CREATE CONSTRAINT community_communityId IF NOT EXISTS FOR (n:Community) REQUIRE n.communityId IS UNIQUE;
CREATE CONSTRAINT event_eventId IF NOT EXISTS FOR (n:Event) REQUIRE n.eventId IS UNIQUE;
CREATE CONSTRAINT project_projectId IF NOT EXISTS FOR (n:Project) REQUIRE n.projectId IS UNIQUE;
CREATE CONSTRAINT group_groupId IF NOT EXISTS FOR (n:Group) REQUIRE n.groupId IS UNIQUE;
CREATE CONSTRAINT class_classId IF NOT EXISTS FOR (n:Class) REQUIRE n.classId IS UNIQUE;
CREATE INDEX x_eid IF NOT EXISTS FOR (n:_X) ON (n._eid);

