<%- include('../partials/head', { title: g.Group_Name }) %>
<a class="backlink" href="/groups">← All groups</a>

<div class="card">
  <div class="spread">
    <div>
      <h1 style="margin-bottom:6px"><%= g.Group_Name %></h1>
      <div class="row-tight">
        <span class="chip"><%= (g.Group_Type || g.Scope_Type || 'GROUP').replace('_',' ') %></span>
        <span class="chip">👤 <%= members.length %> members</span>
        <% if (g.Course_ID) { %><a class="chip brand" href="/academic/courses/<%= g.Course_ID %>">Course page →</a><% } %>
      </div>
    </div>
    <div>
      <% if (isMember) { %>
        <form class="inline-form" action="/groups/<%= g.Group_ID %>/leave" method="post" data-confirm="Leave this group?">
          <button class="btn btn-sm" type="submit">Leave</button>
        </form>
      <% } else { %>
        <form class="inline-form" action="/groups/<%= g.Group_ID %>/join" method="post">
          <button class="btn btn-sm btn-primary" type="submit">Join group</button>
        </form>
      <% } %>
    </div>
  </div>
  <% if (g.Description) { %><p style="margin-top:12px;color:var(--ink-2)"><%= g.Description %></p><% } %>
  <% if (reason) { %><p class="reason" style="margin-top:6px">✦ <%= reason %></p><% } %>
</div>

<div class="grid cols-2" data-reveal>
  <div class="stack">
    <div class="card">
      <div class="card-head"><h3 style="margin:0">Announcements</h3>
        <% if (canAnnounce) { %><span class="chip amber">You can post here</span><% } %>
      </div>
      <div class="stack-sm">
        <% announcements.forEach(function(a){ %>
          <div class="callout <%= a.Is_Official ? 'official' : '' %>">
            <div class="row-tight" style="margin-bottom:3px">
              <% if (a.Is_Official) { %><span class="chip tag-official">Official</span><% } %>
              <strong><%= a.Title %></strong>
            </div>
            <div class="dim" style="white-space:pre-wrap;font-size:.9rem;margin-bottom:4px"><%= a.Content %></div>
            <small class="muted"><%= a.faculty_name %><% if (a.Designation) { %> · <%= a.Designation %><% } %> · <%= timeAgo(a.Published_At) %></small>
          </div>
        <% }) %>
        <% if (!announcements.length) { %><p class="muted" style="margin:0">No announcements yet.</p><% } %>
      </div>

      <% if (canAnnounce) { %>
        <details class="disclose" style="margin-top:14px">
          <summary>Post an announcement</summary>
          <form action="/groups/<%= g.Group_ID %>/announce" method="post" style="margin-top:12px">
            <div class="field"><label for="a_title">Title</label>
              <input id="a_title" name="title" required></div>
            <div class="field"><label for="a_content">Message</label>
              <textarea id="a_content" name="content" data-autogrow required></textarea></div>
            <label style="font-weight:500;display:flex;gap:8px;align-items:flex-start">
              <input type="checkbox" name="is_official" style="width:auto;margin-top:3px">
              <span>Mark as official <small>Applies only if your designation is Dean / HOD / Head / Director</small></span>
            </label>
            <div class="form-actions" style="margin-top:12px">
              <label style="margin:0">Expires <input type="date" name="expiry_date" style="width:auto"></label>
              <button class="btn btn-primary btn-sm" type="submit">Publish</button>
            </div>
          </form>
        </details>
      <% } %>
    </div>

    <%
      var GWIN = 5 * 60 * 1000;
      function _gd(iso){ return new Date((iso || '').replace(' ', 'T')); }
      function _gkey(iso){ var d = _gd(iso); return d.getFullYear() + '-' + (d.getMonth()+1) + '-' + d.getDate(); }
      function _gsep(iso){
        var d = _gd(iso), n = new Date();
        var a = new Date(n.getFullYear(), n.getMonth(), n.getDate()), b = new Date(d.getFullYear(), d.getMonth(), d.getDate());
        var diff = Math.round((a - b) / 86400000);
        if (diff <= 0) return 'Today'; if (diff === 1) return 'Yesterday';
        if (diff < 7) return d.toLocaleDateString('en-US', { weekday: 'long' });
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      }
      function _ghm(iso){ return _gd(iso).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }); }
      function _ghue(id){ return (parseInt(id, 10) * 47) % 360; }
      var grows = messages.map(function (m, i) {
        var p = messages[i-1], nx = messages[i+1];
        var sameP = p && p.User_ID === m.User_ID && _gkey(p.Sent_At) === _gkey(m.Sent_At) && (_gd(m.Sent_At) - _gd(p.Sent_At)) < GWIN;
        var sameN = nx && nx.User_ID === m.User_ID && _gkey(nx.Sent_At) === _gkey(m.Sent_At) && (_gd(nx.Sent_At) - _gd(m.Sent_At)) < GWIN;
        return { m: m, sameP: !!sameP, lastRun: !sameN, newDay: (!p || _gkey(p.Sent_At) !== _gkey(m.Sent_At)),
                 mine: (m.User_ID === currentUser.User_ID) };
      });
    %>
    <div class="chat chat--embedded" id="discussion" data-conv="g<%= g.Group_ID %>">
      <div class="chat-head">
        <span class="avatar sm" style="background:var(--teal-wash);color:var(--teal)">#</span>
        <div style="min-width:0">
          <div class="ttl">Group discussion</div>
          <div class="sub"><%= members.length %> members can see this</div>
        </div>
      </div>

      <div class="chat-scroll" id="gChatScroll">
        <% if (!grows.length) { %>
          <div class="chat-empty">
            <div class="ic">💬</div>
            <h4>No messages yet</h4>
            <p>Start the discussion — everyone in the group can see it.</p>
          </div>
        <% } %>
        <% grows.forEach(function (r) { var m = r.m; %>
          <% if (r.newDay) { %><div class="chat-sep"><span><%= _gsep(m.Sent_At) %></span></div><% } %>
          <div class="msg <%= r.mine ? 'me' : '' %> <%= r.sameP ? 'run' : 'new-sender' %> <%= r.lastRun ? 'last-run' : '' %>"
               data-mid="<%= m.Message_ID %>" data-mine="<%= r.mine ? 1 : 0 %>">
            <% if (!r.mine) { %>
              <div class="msg-avatar <%= r.lastRun ? '' : 'spacer' %>">
                <% if (r.lastRun) { %><%- include('../partials/avatar', { name: m.Full_Name, img: m.Profile_Image, size:'xs', link:'/u/'+m.User_ID }) %><% } %>
              </div>
            <% } %>
            <div class="msg-col">
              <% if (!r.mine && !r.sameP) { %>
                <div class="msg-name" style="--sender:hsl(<%= _ghue(m.User_ID) %> 42% 42%)"><%= m.Full_Name %></div>
              <% } %>
              <div class="bubble"><%= m.Message_Content %></div>
              <% if (r.lastRun) { %><div class="msg-time"><%= _ghm(m.Sent_At) %></div><% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <% if (isMember) { %>
        <form class="chat-composer" action="/groups/<%= g.Group_ID %>/message" method="post">
          <div class="composer-box is-empty">
            <textarea class="composer-input" name="text" rows="1" placeholder="Message the group…"
                      required autocomplete="off" data-autogrow data-enter-send></textarea>
            <button class="composer-send" type="submit" aria-label="Send message">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12l16-8-6 16-2-6-8-2z" fill="currentColor"/></svg>
            </button>
          </div>
          <div class="composer-hint">Enter to send · Shift+Enter for a new line</div>
        </form>
      <% } else { %>
        <div style="padding:14px 18px;border-top:1px solid var(--line-2)"><p class="help-note" style="margin:0">Join the group to take part in the discussion.</p></div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h3 style="margin:0">Members</h3><span class="chip"><%= members.length %></span></div>
    <ul class="list-rows">
      <% members.forEach(function(m){ %>
        <li>
          <%- include('../partials/avatar', { name: m.Full_Name, img: m.Profile_Image, size:'sm', link:'/u/'+m.User_ID }) %>
          <div style="flex:1;min-width:0">
            <a href="/u/<%= m.User_ID %>" style="font-weight:600;color:var(--ink)"><%= m.Full_Name %></a>
            <% if (m.is_faculty) { %><span class="chip amber">Faculty</span><% } else if (m.is_student) { %><span class="chip brand">Student</span><% } %>
            <% if (m.Role && m.Role !== 'MEMBER') { %><span class="chip"><%= m.Role %></span><% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  </div>
</div>
<%- include('../partials/foot') %>
