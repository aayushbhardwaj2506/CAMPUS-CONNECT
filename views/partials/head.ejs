<%
  const isBare = (typeof bare !== 'undefined' && bare);
  const P = (typeof path === 'string') ? path : '';
  function nav(href){ return (P === href || (href !== '/' && P.indexOf(href) === 0)) ? 'active' : ''; }
  const pageTitle = (typeof title !== 'undefined' && title) ? title : '';
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#5b3df5">
  <title><%= pageTitle ? pageTitle + ' · Campus Connect' : 'Campus Connect' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=Newsreader:ital,opsz@0,6..72;1,6..72&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%235b3df5'/%3E%3Cpath d='M21 11.5a6 6 0 100 9' stroke='white' stroke-width='2.6' fill='none' stroke-linecap='round'/%3E%3C/svg%3E">
  <script>
    (function () {
      var r = document.documentElement;
      try {
        var m = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (!m || !m.matches) r.classList.add('anim');
      } catch (e) {}
      try {
        r.classList.add(sessionStorage.getItem('cc_seen_boot') === '1' ? 'cc-boot-seen' : 'cc-loading');
      } catch (e) {}
    })();
  </script>
</head>
<body>
<canvas id="bg-canvas"></canvas>
<%- include('pixel-sprites') %>
<div class="cc-preloader" id="ccPreloader" role="status" aria-label="Loading Campus Connect">
  <div class="cc-pre-particles" aria-hidden="true">
    <% for (var _i = 0; _i < 16; _i++) {
         var _l = (_i * 61) % 100, _d = 6 + ((_i * 37) % 9), _dl = -((_i * 29) % 12),
             _s = 2 + (_i % 3), _dr = ((_i % 2) ? 1 : -1) * (10 + ((_i * 13) % 44)); %>
    <i style="left:<%= _l %>%;width:<%= _s %>px;height:<%= _s %>px;animation-duration:<%= _d %>s;animation-delay:<%= _dl %>s;--drift:<%= _dr %>px"></i>
    <% } %>
  </div>
  <div class="cc-pre-stars" aria-hidden="true">
    <%- include('px', { id: 'star', size: 14, cls: 'pix-twinkle' }) %>
    <%- include('px', { id: 'star', size: 10, cls: 'pix-twinkle' }) %>
    <%- include('px', { id: 'star', size: 12, cls: 'pix-twinkle' }) %>
    <%- include('px', { id: 'star', size: 8,  cls: 'pix-twinkle' }) %>
    <%- include('px', { id: 'star', size: 12, cls: 'pix-twinkle' }) %>
    <%- include('px', { id: 'cloud', size: 40, cls: 'cc-pre-cloud pix-float' }) %>
    <%- include('px', { id: 'cloud', size: 28, cls: 'cc-pre-cloud pix-float' }) %>
  </div>
  <div class="cc-pre-inner">
    <div class="cc-pre-brand">
      <span class="cc-pre-logo" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="22" height="22"><path d="M22 10a8 8 0 100 12" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
      </span>
      <span>Campus&nbsp;Connect</span>
    </div>
    <p class="cc-pre-tag">SCOPE · your school, connected</p>
    <div class="cc-pre-track">
      <svg class="cc-wolf" viewBox="0 0 44 27" aria-hidden="true">
        <g class="cc-wolf-inner">
          <rect x="8" y="24" width="28" height="2" class="pw-gnd"/>
          <g class="cc-tail">
            <rect x="3" y="9"  width="4" height="4" class="pw-bolt"/>
            <rect x="0" y="12" width="4" height="4" class="pw-bolt"/>
            <rect x="3" y="15" width="4" height="4" class="pw-bolt"/>
          </g>
          <g class="cc-mane">
            <rect x="19" y="10" width="11" height="2"  class="pw-bolt"/>
            <rect x="18" y="4"  width="4"  height="8"  class="pw-bolt"/>
            <rect x="22" y="2"  width="4"  height="10" class="pw-bolt"/>
            <rect x="26" y="4"  width="4"  height="8"  class="pw-bolt"/>
          </g>
          <g class="cc-legs cc-legs-b">
            <rect x="10" y="20" width="4" height="6"/>
            <rect x="16" y="20" width="4" height="6"/>
          </g>
          <g class="cc-legs cc-legs-f">
            <rect x="27" y="20" width="4" height="6"/>
            <rect x="33" y="20" width="4" height="6"/>
          </g>
          <rect x="6"  y="9"  width="12" height="12"/>
          <rect x="16" y="12" width="10" height="9"/>
          <rect x="24" y="10" width="7"  height="11"/>
          <rect x="29" y="7"  width="5"  height="8"/>
          <rect x="33" y="5"  width="8"  height="9"/>
          <rect x="40" y="9"  width="4"  height="4"/>
          <rect x="33" y="4"  width="5"  height="2"/>
          <rect x="8"  y="19" width="21" height="2" class="pw-shade"/>
          <rect x="32" y="0" width="3" height="6" class="pw-bolt"/>
          <rect x="37" y="0" width="3" height="5" class="pw-bolt"/>
          <rect x="36" y="8" width="2" height="2" class="cc-eye"/>
          <g class="cc-spark">
            <rect x="9" y="0" width="2" height="3" class="pw-bolt"/>
            <rect x="7" y="3" width="2" height="2" class="pw-bolt"/>
          </g>
        </g>
      </svg>
      <div class="cc-pre-fill"></div>
    </div>
    <div class="cc-pre-scene" aria-hidden="true">
      <%- include('px', { id: 'building', size: 44, cls: 'sc sc-b1' }) %>
      <%- include('px', { id: 'building', size: 34, cls: 'sc sc-b2' }) %>
      <%- include('px', { id: 'tent',     size: 30, cls: 'sc sc-t' }) %>
      <%- include('px', { id: 'signpost', size: 28, cls: 'sc sc-s' }) %>
      <%- include('px', { id: 'sprout',   size: 20, cls: 'sc sc-p' }) %>
      <%- include('px', { id: 'grass',    size: 18, cls: 'sc sc-g1' }) %>
      <%- include('px', { id: 'grass',    size: 16, cls: 'sc sc-g2' }) %>
      <div class="cc-pre-ground"></div>
    </div>
  </div>
</div>
<script>
(function () {
  var d = document, root = d.documentElement, pre = d.getElementById('ccPreloader');
  if (!pre) { root.classList.remove('cc-loading'); return; }
  if (root.classList.contains('cc-boot-seen')) { pre.parentNode && pre.remove(); root.classList.remove('cc-loading'); return; }
  var rm = false; try { rm = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
  var MIN = rm ? 250 : 1000, CAP = 2400, t0 = Date.now(), done = false;
  function finish() {
    if (done) return; done = true;
    try { sessionStorage.setItem('cc_seen_boot', '1'); } catch (e) {}
    var fill = pre.querySelector('.cc-pre-fill');
    if (fill) { fill.style.transition = 'width .35s ease'; fill.style.width = '100%'; }
    setTimeout(function () {
      pre.classList.add('cc-pre-out');
      setTimeout(function () { pre.parentNode && pre.remove(); root.classList.remove('cc-loading'); }, 540);
    }, Math.max(0, MIN - (Date.now() - t0)));
  }
  if (d.readyState === 'complete') finish();
  else addEventListener('load', finish, { once: true });
  setTimeout(finish, CAP);
})();
</script>
<div class="route-progress" id="routeProgress" aria-hidden="true"></div>

<header class="topbar">
  <div class="topbar-inner">
    <% if (currentUser) { %>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    <% } %>
    <a class="brand" href="/">
      <span class="logo" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="20" height="20"><path d="M21 10a7 7 0 100 12" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
      </span>
      <span class="brand-name">Campus&nbsp;Connect</span>
    </a>

    <% if (currentUser) { %>
      <form class="topsearch" action="/search" method="get" role="search">
        <svg class="topsearch-ic" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="2" fill="none"/><path d="M14 14l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="search" name="q" placeholder="Search people, courses, groups, projects…"
               value="<%= (query && query.q) ? query.q : '' %>">
        <kbd>/</kbd>
      </form>
      <span class="grow"></span>
      <a class="icon-action" href="/notifications" title="Notifications" aria-label="Notifications">
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M18 16v-5a6 6 0 10-12 0v5l-1.5 2h15L18 16z" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linejoin="round"/><path d="M10 20a2 2 0 004 0" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
        <% if (unreadCount > 0) { %><span class="badge-dot"><%= unreadCount > 9 ? '9+' : unreadCount %></span><% } %>
      </a>
      <div class="usermenu">
        <a class="usermenu-trigger" href="/profile" title="Your profile">
          <span class="avatar sm"><%
            if (currentUser.profile && currentUser.profile.Profile_Image) { %><img src="<%= currentUser.profile.Profile_Image %>" alt=""><% }
            else { %><%= initials(currentUser.Full_Name) %><% } %></span>
          <span class="usermenu-name"><%= currentUser.Full_Name.split(' ')[0] %></span>
        </a>
        <form class="inline-form" action="/logout" method="post">
          <button class="btn btn-ghost btn-sm" type="submit">Sign out</button>
        </form>
      </div>
    <% } else { %>
      <span class="grow"></span>
      <a class="btn btn-ghost" href="/about">About</a>
      <a class="btn btn-ghost" href="/login">Sign in</a>
      <a class="btn btn-primary" href="/register">Create account</a>
    <% } %>
  </div>
</header>

<% if (!isBare && currentUser) { %>
<div class="shell">
  <div class="nav-scrim" id="navScrim"></div>
  <nav class="sidebar" id="sidebar" aria-label="Primary">
    <span class="sidebar-rail" id="sidebarRail" aria-hidden="true"></span>
    <a class="navitem <%= nav('/') %>" href="/"><span class="navitem-ic">🏠</span><span>Dashboard</span></a>
    <a class="navitem <%= nav('/feed') %>" href="/feed"><span class="navitem-ic">📝</span><span>Feed</span></a>
    <a class="navitem <%= nav('/messages') %>" href="/messages"><span class="navitem-ic">✉️</span><span>Messages</span></a>
    <a class="navitem <%= nav('/notifications') %>" href="/notifications"><span class="navitem-ic">🔔</span><span>Notifications</span>
      <% if (unreadCount > 0) { %><span class="navitem-count"><%= unreadCount %></span><% } %></a>

    <div class="nav-label">Campus life</div>
    <a class="navitem <%= nav('/groups') %>" href="/groups"><span class="navitem-ic">👥</span><span>Groups</span></a>
    <a class="navitem <%= nav('/communities') %>" href="/communities"><span class="navitem-ic">🌐</span><span>Communities</span></a>
    <a class="navitem <%= nav('/clubs') %>" href="/clubs"><span class="navitem-ic">🎭</span><span>Clubs</span></a>
    <a class="navitem <%= nav('/events') %>" href="/events"><span class="navitem-ic">📅</span><span>Events</span></a>

    <div class="nav-label">Study &amp; work</div>
    <a class="navitem <%= nav('/academic') %>" href="/academic"><span class="navitem-ic">🎓</span><span>Academic</span></a>
    <a class="navitem <%= nav('/projects') %>" href="/projects"><span class="navitem-ic">🛠️</span><span>Projects</span></a>
    <a class="navitem <%= nav('/requests') %>" href="/requests"><span class="navitem-ic">🤝</span><span>Requests</span></a>
    <a class="navitem <%= nav('/files') %>" href="/files"><span class="navitem-ic">📁</span><span>Files</span></a>

    <% if (currentUser.role === 'staff') { %>
      <div class="nav-label">Admin</div>
      <a class="navitem <%= nav('/moderation') %>" href="/moderation"><span class="navitem-ic">🛡️</span><span>Moderation</span></a>
      <a class="navitem <%= nav('/audit') %>" href="/audit"><span class="navitem-ic">📜</span><span>Audit log</span></a>
    <% } %>

    <div class="nav-foot">
      <a class="navitem <%= nav('/profile') %>" href="/profile"><span class="navitem-ic">🙋</span><span>Your profile</span></a>
      <a class="navitem <%= nav('/about') %>" href="/about"><span class="navitem-ic">ℹ️</span><span>About</span></a>
      <form action="/logout" method="post" class="nav-signout">
        <button class="navitem" type="submit"><span class="navitem-ic">↩︎</span><span>Sign out</span></button>
      </form>
    </div>
  </nav>

  <main class="content" id="content">
    <% if (flash && flash.length) { %>
      <div class="flash-stack">
      <% flash.forEach(function(f){ %>
        <div class="flash <%= f.type %>" role="status">
          <span class="flash-ic" aria-hidden="true"><%= f.type === 'success' ? '✓' : (f.type === 'error' ? '!' : 'i') %></span>
          <span><%= f.message %></span>
          <button class="flash-x" aria-label="Dismiss">×</button>
        </div>
      <% }) %>
      </div>
    <% } %>
<% } else { %>
  <main class="<%= isBare ? 'bare-main' : 'landing' %>" id="content">
    <% if (flash && flash.length) { %>
      <div class="flash-stack flash-stack--bare">
      <% flash.forEach(function(f){ %>
        <div class="flash <%= f.type %>" role="status">
          <span class="flash-ic" aria-hidden="true"><%= f.type === 'success' ? '✓' : (f.type === 'error' ? '!' : 'i') %></span>
          <span><%= f.message %></span>
          <button class="flash-x" aria-label="Dismiss">×</button>
        </div>
      <% }) %>
      </div>
    <% } %>
<% } %>
