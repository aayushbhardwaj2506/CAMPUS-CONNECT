<%# Campus Connect — original pixel-art sprite sheet (16x16 grid, --px-* palette). %>
<svg class="px-sheet" width="0" height="0" aria-hidden="true" focusable="false"
     style="position:absolute;width:0;height:0;overflow:hidden">
  <defs>

    <symbol id="px-sprout" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="3" y="10" width="10" height="1" fill="var(--px-gold-d)"/>
      <rect x="4" y="11" width="8" height="4" fill="var(--px-gold)"/>
      <rect x="4" y="14" width="8" height="1" fill="var(--px-gold-d)"/>
      <rect x="5" y="10" width="6" height="1" fill="var(--px-ink)"/>
      <rect x="7" y="4" width="2" height="7" fill="var(--px-green-d)"/>
      <rect x="3" y="6" width="4" height="2" fill="var(--px-green)"/>
      <rect x="2" y="7" width="2" height="2" fill="var(--px-green)"/>
      <rect x="9" y="4" width="4" height="2" fill="var(--px-green)"/>
      <rect x="12" y="5" width="2" height="2" fill="var(--px-green)"/>
      <rect x="7" y="2" width="2" height="2" fill="var(--px-green)"/>
    </symbol>

    <symbol id="px-book" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="2" y="11" width="12" height="3" fill="var(--px-body)"/>
      <rect x="2" y="11" width="2" height="3" fill="var(--px-shadow)"/>
      <rect x="3" y="8" width="12" height="3" fill="var(--px-gold)"/>
      <rect x="3" y="8" width="2" height="3" fill="var(--px-gold-d)"/>
      <rect x="2" y="5" width="12" height="3" fill="var(--px-green)"/>
      <rect x="2" y="5" width="2" height="3" fill="var(--px-green-d)"/>
      <rect x="11" y="3" width="2" height="4" fill="var(--px-rose)"/>
      <rect x="2" y="14" width="12" height="1" fill="var(--px-ink)"/>
    </symbol>

    <symbol id="px-cap" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="2" y="6" width="12" height="2" fill="var(--px-ink)"/>
      <rect x="4" y="5" width="8" height="1" fill="var(--px-shadow)"/>
      <rect x="1" y="7" width="14" height="2" fill="var(--px-ink)"/>
      <rect x="7" y="8" width="2" height="1" fill="var(--px-ink)"/>
      <rect x="12" y="8" width="1" height="4" fill="var(--px-gold)"/>
      <rect x="11" y="11" width="3" height="2" fill="var(--px-gold)"/>
      <rect x="6" y="9" width="4" height="2" fill="var(--px-body-2)"/>
    </symbol>

    <symbol id="px-signpost" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="7" y="3" width="2" height="12" fill="var(--px-gold-d)"/>
      <rect x="1" y="4" width="9" height="3" fill="var(--px-body)"/>
      <rect x="0" y="5" width="1" height="1" fill="var(--px-body)"/>
      <rect x="1" y="4" width="9" height="1" fill="var(--px-body-2)"/>
      <rect x="6" y="9" width="9" height="3" fill="var(--px-green)"/>
      <rect x="15" y="10" width="1" height="1" fill="var(--px-green)"/>
      <rect x="6" y="9" width="9" height="1" fill="var(--px-green-d)"/>
      <rect x="4" y="15" width="8" height="1" fill="var(--px-green-d)"/>
    </symbol>

    <symbol id="px-torch" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="7" y="8" width="2" height="8" fill="var(--px-ink)"/>
      <rect x="6" y="8" width="4" height="1" fill="var(--px-gold-d)"/>
      <g class="px-part-a">
        <rect x="5" y="3" width="6" height="5" fill="var(--px-gold-d)"/>
        <rect x="6" y="2" width="4" height="5" fill="var(--px-gold)"/>
        <rect x="7" y="1" width="2" height="4" fill="var(--px-cream)"/>
      </g>
    </symbol>

    <symbol id="px-trophy" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="5" y="2" width="6" height="5" fill="var(--px-gold)"/>
      <rect x="6" y="3" width="1" height="2" fill="var(--px-cream)"/>
      <rect x="3" y="2" width="2" height="3" fill="var(--px-gold-d)"/>
      <rect x="11" y="2" width="2" height="3" fill="var(--px-gold-d)"/>
      <rect x="7" y="7" width="2" height="3" fill="var(--px-gold-d)"/>
      <rect x="5" y="10" width="6" height="2" fill="var(--px-ink)"/>
      <rect x="4" y="12" width="8" height="2" fill="var(--px-ink)"/>
    </symbol>

    <symbol id="px-rocket" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="6" y="1" width="4" height="2" fill="var(--px-rose)"/>
      <rect x="5" y="3" width="6" height="8" fill="var(--px-cream)"/>
      <rect x="5" y="3" width="2" height="8" fill="var(--px-body-2)"/>
      <rect x="7" y="5" width="2" height="2" fill="var(--px-sky)"/>
      <rect x="3" y="8" width="2" height="4" fill="var(--px-body)"/>
      <rect x="11" y="8" width="2" height="4" fill="var(--px-body)"/>
      <g class="px-part-a">
        <rect x="6" y="11" width="4" height="3" fill="var(--px-gold)"/>
        <rect x="7" y="14" width="2" height="2" fill="var(--px-rose)"/>
      </g>
    </symbol>

    <symbol id="px-cup" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <g class="px-part-a">
        <rect x="6" y="0" width="1" height="3" fill="var(--px-body-2)"/>
        <rect x="9" y="1" width="1" height="3" fill="var(--px-body-2)"/>
      </g>
      <rect x="2" y="5" width="11" height="1" fill="var(--px-ink)"/>
      <rect x="3" y="6" width="9" height="6" fill="var(--px-cream)"/>
      <rect x="4" y="6" width="7" height="1" fill="var(--px-shadow)"/>
      <rect x="12" y="7" width="2" height="4" fill="var(--px-ink)"/>
      <rect x="13" y="8" width="1" height="2" fill="var(--px-cream)"/>
      <rect x="2" y="12" width="12" height="1" fill="var(--px-gold-d)"/>
    </symbol>

    <symbol id="px-star" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="7" y="2" width="2" height="12" fill="var(--px-gold)"/>
      <rect x="2" y="7" width="12" height="2" fill="var(--px-gold)"/>
      <rect x="6" y="6" width="4" height="4" fill="var(--px-cream)"/>
      <rect x="7" y="7" width="2" height="2" fill="var(--px-gold)"/>
    </symbol>

    <symbol id="px-bell" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="7" y="2" width="2" height="2" fill="var(--px-gold-d)"/>
      <rect x="5" y="4" width="6" height="7" fill="var(--px-gold)"/>
      <rect x="4" y="7" width="1" height="4" fill="var(--px-gold)"/>
      <rect x="11" y="7" width="1" height="4" fill="var(--px-gold)"/>
      <rect x="6" y="5" width="1" height="3" fill="var(--px-cream)"/>
      <rect x="3" y="11" width="10" height="1" fill="var(--px-ink)"/>
      <rect x="7" y="12" width="2" height="2" fill="var(--px-gold-d)"/>
    </symbol>

    <symbol id="px-folder" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="2" y="4" width="6" height="2" fill="var(--px-body)"/>
      <rect x="4" y="4" width="8" height="1" fill="var(--px-cream)"/>
      <rect x="1" y="6" width="14" height="8" fill="var(--px-body-2)"/>
      <rect x="1" y="6" width="14" height="1" fill="var(--px-body)"/>
      <rect x="1" y="13" width="14" height="1" fill="var(--px-shadow)"/>
    </symbol>

    <symbol id="px-tent" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="8" y="1" width="1" height="2" fill="var(--px-rose)"/>
      <rect x="9" y="1" width="2" height="1" fill="var(--px-rose)"/>
      <rect x="7" y="3" width="2" height="1" fill="var(--px-green-d)"/>
      <rect x="6" y="4" width="4" height="1" fill="var(--px-green-d)"/>
      <rect x="5" y="5" width="6" height="1" fill="var(--px-green)"/>
      <rect x="4" y="6" width="8" height="1" fill="var(--px-green)"/>
      <rect x="2" y="7" width="12" height="6" fill="var(--px-green)"/>
      <rect x="7" y="8" width="2" height="5" fill="var(--px-ink)"/>
      <rect x="9" y="8" width="2" height="5" fill="var(--px-green-d)"/>
      <rect x="1" y="13" width="14" height="1" fill="var(--px-green-d)"/>
    </symbol>

    <symbol id="px-chat" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="2" y="3" width="12" height="8" fill="var(--px-body)"/>
      <rect x="2" y="3" width="12" height="1" fill="var(--px-body-2)"/>
      <rect x="4" y="11" width="3" height="3" fill="var(--px-body)"/>
      <rect x="4" y="6" width="8" height="1" fill="var(--px-cream)"/>
      <rect x="4" y="8" width="5" height="1" fill="var(--px-cream)"/>
    </symbol>

    <symbol id="px-hero" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="5" y="1" width="6" height="2" fill="var(--px-body)"/>
      <rect x="5" y="0" width="4" height="1" fill="var(--px-body-2)"/>
      <rect x="5" y="3" width="6" height="4" fill="var(--px-cream)"/>
      <rect x="6" y="4" width="1" height="1" fill="var(--px-ink)"/>
      <rect x="9" y="4" width="1" height="1" fill="var(--px-ink)"/>
      <rect x="4" y="7" width="8" height="6" fill="var(--px-body)"/>
      <rect x="4" y="7" width="8" height="1" fill="var(--px-body-2)"/>
      <rect x="3" y="8" width="1" height="4" fill="var(--px-body)"/>
      <rect x="12" y="8" width="1" height="4" fill="var(--px-body)"/>
      <rect x="10" y="7" width="1" height="6" fill="var(--px-gold)"/>
      <rect x="10" y="10" width="3" height="3" fill="var(--px-gold-d)"/>
      <rect x="5" y="13" width="2" height="2" fill="var(--px-ink)"/>
      <rect x="9" y="13" width="2" height="2" fill="var(--px-ink)"/>
      <rect x="4" y="15" width="3" height="1" fill="var(--px-shadow)"/>
      <rect x="9" y="15" width="3" height="1" fill="var(--px-shadow)"/>
    </symbol>

    <symbol id="px-grass" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="2" y="9" width="2" height="5" fill="var(--px-green)"/>
      <rect x="5" y="7" width="2" height="7" fill="var(--px-green-d)"/>
      <rect x="8" y="8" width="2" height="6" fill="var(--px-green)"/>
      <rect x="11" y="6" width="2" height="8" fill="var(--px-green-d)"/>
      <rect x="1" y="14" width="14" height="1" fill="var(--px-green-d)"/>
    </symbol>

    <symbol id="px-cloud" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="3" y="7" width="10" height="4" fill="var(--px-cream)"/>
      <rect x="1" y="9" width="14" height="2" fill="var(--px-cream)"/>
      <rect x="5" y="5" width="4" height="2" fill="var(--px-cream)"/>
      <rect x="9" y="6" width="3" height="1" fill="var(--px-cream)"/>
      <rect x="1" y="11" width="14" height="1" fill="var(--px-sky)"/>
    </symbol>

    <symbol id="px-building" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="2" y="4" width="12" height="12" fill="var(--px-shadow)"/>
      <rect x="1" y="3" width="14" height="1" fill="var(--px-ink)"/>
      <rect x="7" y="0" width="1" height="3" fill="var(--px-ink)"/>
      <rect x="6" y="0" width="1" height="1" fill="var(--px-rose)"/>
      <rect x="3" y="6" width="2" height="2" fill="var(--px-sky)"/>
      <rect x="7" y="6" width="2" height="2" fill="var(--px-sky)"/>
      <rect x="11" y="6" width="2" height="2" fill="var(--px-sky)"/>
      <rect x="3" y="10" width="2" height="2" fill="var(--px-sky)"/>
      <rect x="7" y="10" width="2" height="2" fill="var(--px-gold)"/>
      <rect x="11" y="10" width="2" height="2" fill="var(--px-sky)"/>
      <rect x="6" y="13" width="4" height="3" fill="var(--px-ink)"/>
    </symbol>

    <symbol id="px-coin" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="5" y="3" width="6" height="10" fill="var(--px-gold)"/>
      <rect x="4" y="5" width="1" height="6" fill="var(--px-gold)"/>
      <rect x="11" y="5" width="1" height="6" fill="var(--px-gold)"/>
      <rect x="5" y="3" width="6" height="1" fill="var(--px-cream)"/>
      <rect x="7" y="5" width="2" height="6" fill="var(--px-gold-d)"/>
      <rect x="5" y="12" width="6" height="1" fill="var(--px-gold-d)"/>
    </symbol>

    <symbol id="px-flag" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="5" y="2" width="2" height="13" fill="var(--px-ink)"/>
      <rect x="7" y="3" width="7" height="5" fill="var(--px-body)"/>
      <rect x="7" y="3" width="7" height="1" fill="var(--px-body-2)"/>
      <rect x="11" y="5" width="2" height="2" fill="var(--px-cream)"/>
      <rect x="3" y="15" width="8" height="1" fill="var(--px-green-d)"/>
    </symbol>

    <symbol id="px-heart" viewBox="0 0 16 16" shape-rendering="crispEdges">
      <rect x="3" y="4" width="4" height="3" fill="var(--px-rose)"/>
      <rect x="9" y="4" width="4" height="3" fill="var(--px-rose)"/>
      <rect x="2" y="6" width="12" height="3" fill="var(--px-rose)"/>
      <rect x="4" y="9" width="8" height="2" fill="var(--px-rose)"/>
      <rect x="6" y="11" width="4" height="2" fill="var(--px-rose)"/>
      <rect x="4" y="5" width="2" height="1" fill="var(--px-cream)"/>
    </symbol>

  </defs>
</svg>
