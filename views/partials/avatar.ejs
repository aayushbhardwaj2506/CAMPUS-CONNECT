<%
  const _size = (typeof size !== 'undefined' && size) ? size : '';
  const _img = (typeof img !== 'undefined') ? img : null;
  const _name = (typeof name !== 'undefined') ? name : '';
  const _link = (typeof link !== 'undefined' && link) ? link : null;
%><% if (_link) { %><a href="<%= _link %>" class="avatar <%= _size %>" title="<%= _name %>"><% } else { %><span class="avatar <%= _size %>"><% } %><%
  if (_img) { %><img src="<%= _img %>" alt="<%= _name %>"><% } else { %><%= initials(_name) %><% }
%><% if (_link) { %></a><% } else { %></span><% } %>
