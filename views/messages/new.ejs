<%- include('../partials/head', { title: 'New message' }) %>
<a class="backlink" href="/messages">← Messages</a>
<div class="card" style="max-width:560px">
  <h1>New message</h1>

  <% if (toUser) { %>
    <form action="/messages" method="post">
      <input type="hidden" name="to" value="<%= toUser.User_ID %>">
      <p>To: <strong><%= toUser.Full_Name %></strong> · <a href="/messages/new">change</a></p>
      <div class="field"><label for="body">Message</label><textarea id="body" name="body" data-autogrow required autofocus></textarea></div>
      <button class="btn btn-primary" type="submit">Send</button>
    </form>
  <% } else { %>
    <form method="get" action="/messages/new" class="row" style="margin-bottom:12px">
      <input name="q" value="<%= q || '' %>" placeholder="Search people by name or email" autofocus>
      <button class="btn btn-sm btn-primary" type="submit">Search</button>
    </form>
    <ul class="list-plain">
      <% (people || []).forEach(function(p){ %>
        <li class="between">
          <div><a href="/messages/new?to=<%= p.User_ID %>" style="font-weight:650"><%= p.Full_Name %></a>
            <div><small class="muted"><%= p.Email %></small></div></div>
          <a class="btn btn-sm btn-primary" href="/messages/new?to=<%= p.User_ID %>">Message</a>
        </li>
      <% }) %>
      <% if (q && !(people && people.length)) { %><li class="muted">No one matches "<%= q %>".</li><% } %>
      <% if (!q) { %><li class="muted">Type a name to find someone.</li><% } %>
    </ul>
  <% } %>
</div>
<%- include('../partials/foot') %>
