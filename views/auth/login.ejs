<%- include('../partials/head', { title: 'Sign in', bare: true }) %>
<div class="auth-wrap" data-reveal>
  <div class="auth-brand">
    <span class="logo" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="22" height="22"><path d="M22 10a8 8 0 100 12" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
    </span>
  </div>
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="dim">Sign in to Campus Connect.</p>
    <form action="/login" method="post">
      <input type="hidden" name="next" value="<%= next || '' %>">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autofocus autocomplete="email" placeholder="you@campus.edu">
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••">
      </div>
      <button class="btn btn-primary btn-block btn-lg" type="submit">Sign in</button>
    </form>
    <p style="margin-top:16px" class="dim">New to Campus Connect? <a href="/register">Create an account</a></p>
  </div>
  <div class="help-note" style="margin-top:14px">
    <strong>Demo accounts</strong> — password <code>campus123</code><br>
    <code>aarav@campus.edu</code> · student &nbsp;|&nbsp;
    <code>suresh.rao@campus.edu</code> · faculty &nbsp;|&nbsp;
    <code>admin@campus.edu</code> · staff
  </div>
</div>
<%- include('../partials/foot', { bare: true }) %>
