<%- include('../partials/head', { title: 'Sign in', bare: true }) %>
<div class="auth-wrap" data-reveal>
  <div class="auth-brand">
    <span class="logo" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="22" height="22"><path d="M22 10a8 8 0 100 12" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
    </span>
  </div>
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="dim">Sign in to Campus Connect.</p>
    <form action="/login" method="post">
      <input type="hidden" name="next" value="<%= next || '' %>">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autofocus autocomplete="email" placeholder="you@campus.edu">
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••">
      </div>
      <button class="btn btn-primary btn-block btn-lg" type="submit">Sign in</button>
    </form>
    <p style="margin-top:16px" class="dim">New to Campus Connect? <a href="/register">Create an account</a></p>
  </div>
  <div class="help-note" style="margin-top:14px">
    <div style="font-weight:700;margin-bottom:8px">Demo Accounts (Password: <code>campus123</code>):</div>
    <div style="display:flex;flex-direction:column;gap:6px">
      <button type="button" class="btn btn-sm btn-subtle" onclick="quickFill('aarav@campus.edu', 'campus123')" style="width:100%;text-align:left;justify-content:flex-start;padding:6px 10px;cursor:pointer">
        ⚡ <strong>aarav@campus.edu</strong> &nbsp;· Student (Aarav)
      </button>
      <button type="button" class="btn btn-sm btn-subtle" onclick="quickFill('suresh.rao@campus.edu', 'campus123')" style="width:100%;text-align:left;justify-content:flex-start;padding:6px 10px;cursor:pointer">
        ⚡ <strong>suresh.rao@campus.edu</strong> &nbsp;· Faculty (Dr. Rao)
      </button>
      <button type="button" class="btn btn-sm btn-subtle" onclick="quickFill('admin@campus.edu', 'campus123')" style="width:100%;text-align:left;justify-content:flex-start;padding:6px 10px;cursor:pointer">
        ⚡ <strong>admin@campus.edu</strong> &nbsp;· Staff / Admin
      </button>
    </div>
  </div>
</div>
<script>
function quickFill(email, pwd) {
  var e = document.getElementById('email');
  var p = document.getElementById('password');
  if (e) e.value = email;
  if (p) p.value = pwd;
  var form = document.querySelector('form');
  if (form) form.submit();
}
</script>
<%- include('../partials/foot', { bare: true }) %>
